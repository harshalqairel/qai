# Public Supabase connection details from the project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep false until the Supabase migration has been applied and cloud repositories
# have replaced localStorage as the authoritative data source.
NEXT_PUBLIC_QAI_CLOUD_ENABLED=false

# Server-only keys. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Identity Services client ID used by the opt-in Sheets snapshot export.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-side Google OAuth / Calendar integration (later launch phase).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AI booking extraction provider (later launch phase).
AI_PROVIDER_API_KEY=

# Xendit SaaS billing (later launch phase).
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Canonical production URL, for example https://qai.example.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000
